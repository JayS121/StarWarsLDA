   "source": [
    "Let's create a function that does this data cleaning for us! We'll remove stage directions in all caps, character names before dialogue, fully capitalized lines, and any extra blank spaces so the text is easier to work with."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "60169cf0-f67d-4995-9b6d-0a5c3b34ecc9",
   "metadata": {},
   "outputs": [],
   "source": [
    "def clean_solo_script(text):\n",
    "    # Remove anything in parentheses and all caps\n",
    "    text = re.sub(r\"\\([A-Z\\s']+\\)\", \"\", text)\n",
    "\n",
    "    # Remove character names that appear before colons \n",
    "    text = re.sub(r\"\\b[A-Z][A-Z0-9\\s]{1,20}:\\s*\", \"\", text)\n",
    "    \n",
    "    # Remove fully capitalized lines that are not in parentheses\n",
    "    text = \"\\n\".join([line for line in text.splitlines() if not line.strip().isupper()])\n",
    "\n",
    "    # Any gaps in text that are 2 or more lines are reduced down to one line\n",
    "    text = re.sub(r\"\\n{2,}\", \"\\n\", text)\n",
    "    text = text.strip()\n",
    "\n",
    "    return text\n",
    "\n",
    "#Apply the function to the Solo movie script\n",
    "df.loc[df['title'] == 'Solo', 'script'] = df.loc[df['title'] == 'Solo', 'script'].apply(clean_solo_script)\n"
   ]
  },
