   "source": [
    "That worked! Now let's process our text by lowercasing all the words, removing punctuation, and lemmatizing (simplifying) words.\n",
    "\n",
    "By standardizing the text, we help the algorithm work better and more consistently. After that, let's add a column to our dataframe called \"tokens\" which has these results.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 57,
   "id": "042deb80-92d4-47de-818d-e6ff78e2cf21",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def process_text(\n",
    "    text: str,\n",
    "    lower_case: bool = True,\n",
    "    remove_punct: bool = True,\n",
    "    remove_stopwords: bool = False,\n",
    "    lemma: bool = False,\n",
    "    string_or_list: str = \"str\",\n",
    "):\n",
    "\n",
    "    tokens = nltk.word_tokenize(text)\n",
    "\n",
    "    if lower_case:\n",
    "        tokens = [token.lower() if token.isalpha() else token for token in tokens]\n",
    "\n",
    "    if remove_punct:\n",
    "        tokens = [token for token in tokens if token.isalpha()]\n",
    "\n",
    "    if remove_stopwords:\n",
    "        tokens = [token for token in tokens if not token in STOPLIST]\n",
    "\n",
    "    if lemma:\n",
    "        tokens = [nltk.wordnet.WordNetLemmatizer().lemmatize(token) for token in tokens]\n",
    "\n",
    "    if string_or_list != \"list\":\n",
    "        doc = \" \".join(tokens)\n",
    "    else:\n",
    "        doc = tokens\n",
    "\n",
    "    return doc\n"
   ]
  },
